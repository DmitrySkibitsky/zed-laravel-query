{
  "name": "laravel-query-language-server",
  "version": "0.1.0",
  "private": true,
  "description": "Database-aware language server for the Laravel query builder, Eloquent and migrations",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test --test-skip-pattern=e2e \"test/**/*.test.ts\"",
    "bench": "node bench/completion.bench.ts"
  },
  "dependencies": {
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-uri": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
